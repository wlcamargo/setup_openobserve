# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real credentials.
#
# Defaults below target the local MinIO container (S3 simulator).
# To use real AWS S3, set your AWS keys/bucket and point S3_SERVER_URL
# to https://s3.<region>.amazonaws.com.

AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_SERVER_URL=http://minio:9000
S3_BUCKET_NAME=openobserve
S3_BUCKET_PREFIX=openobserve/
